{
  "name": "log-upload-worker",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-22",
  "workers_dev": true,
  "preview_urls": false,

  "r2_buckets": [
    {
      "binding": "LOGS_BUCKET",
      "bucket_name": "your-r2-bucket-name"
    }
  ],

  "ratelimits": [
    {
      "name": "UPLOAD_IP_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "UPLOAD_GLOBAL_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],

  "vars": {
    "MAX_UPLOAD_BYTES": "1048576"
  }
}
